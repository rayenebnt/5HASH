#!/usr/bin/env bash
# {{ ansible_managed }}
#
# Writes the database credentials of this environment to {{ prestashop_config_dir }}/db.env.
#
# The password is read from AWS Secrets Manager with the IAM role of this
# instance: it is never stored in Git, never passed on a command line and never
# printed. The file is only readable by root and is consumed by the PrestaShop
# container through `docker run --env-file`.
#
# Prints "changed" when the file was created or updated, "unchanged" otherwise,
# which is what makes the Ansible task idempotent.

set -euo pipefail

SECRET_ID="{{ db_secret_arn }}"
REGION="{{ aws_region }}"
TARGET="{{ prestashop_config_dir }}/db.env"

umask 077
TMP="$(mktemp "${TARGET}.XXXXXX")"
trap 'rm -f "${TMP}"' EXIT

SECRET="$(aws secretsmanager get-secret-value \
  --secret-id "${SECRET_ID}" \
  --region "${REGION}" \
  --query SecretString \
  --output text)"

DB_USER="$(printf '%s' "${SECRET}" | jq -re '.username')"
DB_PASSWD="$(printf '%s' "${SECRET}" | jq -re '.password')"
DB_HOST="$(printf '%s' "${SECRET}" | jq -re '.host')"
DB_PORT="$(printf '%s' "${SECRET}" | jq -re '.port')"
DB_NAME="$(printf '%s' "${SECRET}" | jq -re '.dbname')"

cat > "${TMP}" <<ENVFILE
# {{ ansible_managed }}
# Generated from AWS Secrets Manager (${SECRET_ID}).
DB_SERVER=${DB_HOST}
DB_PORT=${DB_PORT}
DB_NAME=${DB_NAME}
DB_USER=${DB_USER}
DB_PASSWD=${DB_PASSWD}
DB_PREFIX={{ prestashop_db_prefix }}
ENVFILE

if [ -f "${TARGET}" ] && cmp -s "${TMP}" "${TARGET}"; then
  echo "unchanged"
else
  mv "${TMP}" "${TARGET}"
  chmod 0600 "${TARGET}"
  echo "changed"
fi
