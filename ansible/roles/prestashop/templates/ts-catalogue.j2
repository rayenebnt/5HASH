#!/usr/bin/env bash
# {{ ansible_managed }}
#
# Applies the ticket shop catalogue, once per content.
#
# The checksum of the SQL file is stored in the shop configuration: while it
# matches, the script touches nothing and answers "uptodate". Editing the
# catalogue changes the checksum, so the script replays it.

set -euo pipefail

ENV_FILE="{{ prestashop_config_dir }}/db.env"
SQL_FILE="{{ prestashop_config_dir }}/catalogue.sql"
MARKER="TS_CATALOGUE"

for f in "${ENV_FILE}" "${SQL_FILE}"; do
  if [ ! -r "${f}" ]; then
    echo "unreadable file: ${f}" >&2
    exit 1
  fi
done

# Read, never sourced: a password containing &, $ or ; would be executed.
read_env() {
  sed -n "s/^$1=//p" "${ENV_FILE}" | head -1
}

DB_SERVER="$(read_env DB_SERVER)"
DB_PORT="$(read_env DB_PORT)"
DB_NAME="$(read_env DB_NAME)"
DB_USER="$(read_env DB_USER)"
DB_PREFIX="$(read_env DB_PREFIX)"

MYSQL_PWD="$(read_env DB_PASSWD)"
export MYSQL_PWD

mysql_args=(--host="${DB_SERVER}" --port="${DB_PORT}" --user="${DB_USER}"
            --database="${DB_NAME}" --batch --skip-column-names --connect-timeout=10)

want="$(sha256sum "${SQL_FILE}" | cut -c1-32)"
have="$(mysql "${mysql_args[@]}" -e \
         "SELECT value FROM ${DB_PREFIX}configuration WHERE name = '${MARKER}' LIMIT 1" || true)"

if [ "${have}" = "${want}" ]; then
  echo "uptodate"
  exit 0
fi

mysql "${mysql_args[@]}" < "${SQL_FILE}"

mysql "${mysql_args[@]}" -e \
  "DELETE FROM ${DB_PREFIX}configuration WHERE name = '${MARKER}';
   INSERT INTO ${DB_PREFIX}configuration (name, value, date_add, date_upd)
   VALUES ('${MARKER}', '${want}', NOW(), NOW());"

echo "changed"
