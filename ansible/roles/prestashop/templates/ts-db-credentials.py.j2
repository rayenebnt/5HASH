#!/usr/bin/env python3
# {{ ansible_managed }}
"""Write the database credentials of this environment to the shop's env file.

The password is read from AWS Secrets Manager with the IAM role of this
instance: it is never stored in Git, never passed on a command line and never
printed. The file is only readable by root and is consumed by the PrestaShop
container through `docker run --env-file`.

Prints "changed" when the file was created or updated, "uptodate" otherwise.
The two words share no prefix on purpose: the Ansible task compares them
exactly, and "changed" being a substring of "unchanged" made this task report
a change on every single run.
"""

import json
import os
import stat
import tempfile

import boto3

SECRET_ID = "{{ db_secret_arn }}"
REGION = "{{ aws_region }}"
TARGET = "{{ prestashop_config_dir }}/db.env"
DB_PREFIX = "{{ prestashop_db_prefix }}"


def render(secret):
    lines = [
        "# {{ ansible_managed }}",
        f"# Generated from AWS Secrets Manager ({SECRET_ID}).",
        f"DB_SERVER={secret['host']}",
        f"DB_PORT={secret['port']}",
        f"DB_NAME={secret['dbname']}",
        f"DB_USER={secret['username']}",
        f"DB_PASSWD={secret['password']}",
        f"DB_PREFIX={DB_PREFIX}",
    ]
    return "\n".join(lines) + "\n"


def main():
    client = boto3.client("secretsmanager", region_name=REGION)
    secret = json.loads(client.get_secret_value(SecretId=SECRET_ID)["SecretString"])
    content = render(secret)

    try:
        with open(TARGET, encoding="utf-8") as current:
            if current.read() == content:
                print("uptodate")
                return
    except FileNotFoundError:
        pass

    # Written through a temporary file in the same directory, so the shop never
    # reads a half-written env file.
    handle, temporary = tempfile.mkstemp(dir=os.path.dirname(TARGET))
    try:
        with os.fdopen(handle, "w", encoding="utf-8") as new:
            new.write(content)
        os.chmod(temporary, stat.S_IRUSR | stat.S_IWUSR)
        os.replace(temporary, TARGET)
    except BaseException:
        os.unlink(temporary)
        raise

    print("changed")


main()
